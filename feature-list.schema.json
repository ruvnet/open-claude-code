{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/feature-list.schema.json",
  "title": "Agent harness feature state",
  "type": "object",
  "additionalProperties": false,
  "required": ["features"],
  "properties": {
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "const": "in-progress" } }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "description", "dependencies", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^feat-[0-9]{3,}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^feat-[0-9]{3,}$" },
          "uniqueItems": true
        },
        "status": {
          "enum": ["not-started", "in-progress", "blocked", "done"]
        },
        "evidence": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "testedAt": { "type": "string", "format": "date-time" },
        "verificationCommands": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "verification": { "$ref": "#/$defs/verification" },
        "blocker": { "type": "string", "minLength": 1 },
        "recommendedNextStep": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "done" } } },
          "then": {
            "required": ["verification"],
            "properties": { "evidence": { "minLength": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": { "required": ["blocker", "recommendedNextStep"] }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandEvidence" }
        }
      }
    },
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "startTime", "endTime", "exitCode", "result", "counts"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "exitCode": { "type": "integer", "const": 0 },
        "result": { "type": "string", "minLength": 1 },
        "counts": {
          "type": "object",
          "required": ["passed", "failed"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "const": 0 }
          },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
